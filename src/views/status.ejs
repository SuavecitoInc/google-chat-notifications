    <div class="status">
      <svg class="center" width="60" height="60" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Changed to a stroke-based path for a chunkier look -->
        <path d="M5 13L9 17L19 7" stroke="#4CAF50" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <h3 class="text-center">ALL SYSTEMS OPERATIONAL</h3>
      <div class="flex">
        <div class="flex-item text-right">
          <strong>UPTIME:</strong>
        </div>
        <div class="flex-item text-left" id="uptimeDisplay">
          <%= formatted_uptime %>
        </div>
      </div>
      <div class="flex">
        <div class="flex-item text-right">
          <strong>IP:</strong>
        </div>
        <div class="flex-item text-left">
          <%= ip %>
        </div>
      </div>
    </div>

    <script type="text/javascript">
      // Get the element where the uptime will be displayed
      const uptimeDisplayElement = document.getElementById('uptimeDisplay');
      // Record the time when the page loaded (in milliseconds)
      // use uptime variable from EJS to set the initial time
      const currentTimestampMs = Date.now();
      const offsetMs = Number("<%= uptime %>") * 1000;
      const newTimestampMs = currentTimestampMs - offsetMs;
      const startTime = new Date(newTimestampMs).getTime();

      /**
       * Formats a given number of seconds into HH:MM:SS format.
       * @param {number} totalSeconds - The total number of seconds.
       * @returns {string} The formatted time string.
       */
      function formatTime(totalSeconds) {
        // Calculate hours, minutes, and remaining seconds
        const hours = Math.floor(totalSeconds / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;

        // Pad single-digit numbers with a leading zero
        const pad = (num) => num.toString().padStart(2, '0');

        return `${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;
      }

      /**
       * Updates the uptime display.
       * This function is called repeatedly by setInterval.
       */
      function updateUptime() {
        // Calculate the current elapsed time in milliseconds
        const currentTime = Date.now();
        const elapsedTimeMs = currentTime - startTime;
        // Convert elapsed time to total seconds
        const elapsedTimeSeconds = Math.floor(elapsedTimeMs / 1000);

        // Update the text content of the display element
        uptimeDisplayElement.textContent = formatTime(elapsedTimeSeconds);
      }

      // Call updateUptime immediately to show 00:00:00 or current time on load
      updateUptime();

      // Set an interval to call updateUptime every 1000 milliseconds (1 second)
      setInterval(updateUptime, 1000);
    </script>

  </div>
